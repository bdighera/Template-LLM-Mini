          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Recipient",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^T[0-9]{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "kind": {
          "enum": [
            "question",
            "finding",
            "discussion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "body": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "artifact_refs": {
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "correlation_id",
        "operation",
        "recipient",
        "kind",
        "body"
      ],
      "title": "Send",
      "type": "object"
    },
    "WorkflowStatus": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
