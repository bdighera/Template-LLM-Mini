        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Request Id",
          "type": "string"
        },
        "correlation_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Correlation Id",
          "type": "string"
        },
        "operation": {
          "const": "workflow_status",
          "title": "Operation",
          "type": "string"
        },
        "task_id": {
          "pattern": "^T[0-9]{3,}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "correlation_id",
        "operation",
        "task_id"
      ],
      "title": "WorkflowStatus",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "accept": "#/$defs/Accept",
      "acknowledge": "#/$defs/Acknowledge",
      "assign": "#/$defs/Assign",
      "inbox": "#/$defs/Inbox",
      "inspect": "#/$defs/Inspect",
      "register": "#/$defs/Register",
      "result": "#/$defs/Result",
      "send": "#/$defs/Send",
      "workflow_status": "#/$defs/WorkflowStatus"
    },
    "propertyName": "operation"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Register"
    },
    {
      "$ref": "#/$defs/Send"
    },
    {
      "$ref": "#/$defs/Inbox"
    },
    {
      "$ref": "#/$defs/Acknowledge"
    },
    {
      "$ref": "#/$defs/Assign"
    },
    {
      "$ref": "#/$defs/Accept"
    },
    {
      "$ref": "#/$defs/Result"
    },
    {
      "$ref": "#/$defs/Inspect"
    },
    {
      "$ref": "#/$defs/WorkflowStatus"
    }
  ]
}
