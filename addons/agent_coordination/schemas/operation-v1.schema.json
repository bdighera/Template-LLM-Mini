        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Request Id",
          "type": "string"
        },
        "correlation_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Correlation Id",
          "type": "string"
        },
        "operation": {
          "const": "inspect",
          "title": "Operation",
          "type": "string"
        },
        "assignment_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Assignment Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "correlation_id",
        "operation",
        "assignment_id"
      ],
      "title": "Inspect",
      "type": "object"
    },
    "Register": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Request Id",
          "type": "string"
        },
        "correlation_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Correlation Id",
          "type": "string"
        },
        "operation": {
          "const": "register",
          "title": "Operation",
          "type": "string"
        },
        "display_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "correlation_id",
        "operation",
        "display_name"
      ],
      "title": "Register",
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Request Id",
          "type": "string"
        },
        "correlation_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Correlation Id",
          "type": "string"
        },
        "operation": {
          "const": "result",
          "title": "Operation",
          "type": "string"
        },
        "assignment_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Assignment Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "completed",
            "needs_input",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "summary": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "artifact_refs": {
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "correlation_id",
        "operation",
        "assignment_id",
        "outcome",
        "summary"
      ],
      "title": "Result",
      "type": "object"
    },
    "Send": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Request Id",
          "type": "string"
        },
        "correlation_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Correlation Id",
          "type": "string"
        },
        "operation": {
          "const": "send",
          "title": "Operation",
          "type": "string"
        },
